.switch-wrap {
  padding: 24rpx 0 8rpx;
  display: flex;
  justify-content: center;
}

.seg {
  display: flex;
  background: #e8ecf7;
  border-radius: 999rpx;
  padding: 6rpx;
}

.seg-item {
  width: 180rpx;
  text-align: center;
  line-height: 64rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  color: #6b7280;
}

.seg-item.active {
  background: #ffffff;
  color: #4b6ef5;
  font-weight: 600;
  box-shadow: 0 4rpx 12rpx rgba(31, 35, 48, 0.08);
}

.amount-card {
  background: #ffffff;
  border-radius: 24rpx;
  margin: 24rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(31, 35, 48, 0.05);
}

.amount-line {
  display: flex;
  align-items: baseline;
  border-bottom: 2rpx solid #f0f2f8;
  padding-bottom: 20rpx;
}

.cny {
  font-size: 40rpx;
  color: #9aa0b5;
  margin-right: 12rpx;
}

.amount-input {
  flex: 1;
  font-size: 64rpx;
  font-weight: 600;
  height: 88rpx;
}

.amount-ph {
  color: #d6dae5;
  font-weight: 600;
}

.quick {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.quick-item {
  padding: 8rpx 24rpx;
  margin: 8rpx 12rpx 0 0;
  background: #f4f6fb;
  color: #6b7280;
  border-radius: 999rpx;
  font-size: 24rpx;
}

.cat-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.cat-item {
  width: 20%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 28rpx;
  opacity: 0.7;
}

.cat-item.active {
  opacity: 1;
}

.cat-icon {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  margin-bottom: 8rpx;
  border: 4rpx solid transparent;
}

.cat-item.active .cat-icon {
  border-color: #4b6ef5;
}

.cat-name {
  font-size: 24rpx;
}

.rows {
  padding: 0 28rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 2rpx solid #f2f4f9;
}

.row:last-child {
  border-bottom: none;
}

.row-label {
  font-size: 28rpx;
  color: #6b7280;
}

.row-value {
  font-size: 28rpx;
}

.row-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
}

.actions {
  margin: 40rpx 24rpx 0;
}

.actions button {
  margin-bottom: 24rpx;
}
