.header {
  background: linear-gradient(160deg, #4b6ef5 0%, #6d8bff 100%);
  color: #ffffff;
  padding: 24rpx 32rpx 40rpx;
  border-bottom-left-radius: 32rpx;
  border-bottom-right-radius: 32rpx;
}

.month-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 8rpx 0 24rpx;
}

.month-text {
  font-size: 30rpx;
  margin: 0 24rpx;
}

.arrow {
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  font-size: 34rpx;
}

.summary {
  display: flex;
  align-items: flex-end;
}

.summary-col {
  flex: 1;
}

.summary-col.mid {
  text-align: center;
}

.summary-col.right {
  text-align: right;
}

.summary-label {
  display: block;
  font-size: 24rpx;
  opacity: 0.85;
  margin-bottom: 6rpx;
}

.summary-value {
  font-size: 40rpx;
  font-weight: 600;
  color: #ffffff;
}

.budget {
  margin-top: 32rpx;
}

.budget.tip {
  font-size: 24rpx;
  opacity: 0.85;
}

.budget-line {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  margin-bottom: 12rpx;
  opacity: 0.95;
}

.progress {
  height: 10rpx;
  background: rgba(255, 255, 255, 0.28);
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-inner {
  height: 100%;
  background: #ffffff;
  border-radius: 999rpx;
  transition: width 0.3s;
}

.progress-inner.over {
  background: #ffd0d5;
}

.list-wrap {
  padding: 0 24rpx;
}

.list-head {
  display: flex;
  justify-content: space-between;
  padding: 20rpx 8rpx 4rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.hint {
  color: #9aa0b5;
}

.group-head {
  padding: 20rpx 8rpx 12rpx;
  font-size: 26rpx;
}

.group-date {
  font-weight: 600;
}

.group-sum {
  font-size: 24rpx;
}

.bill-list {
  margin: 0;
  padding: 0 24rpx;
}

.bill {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f2f4f9;
}

.bill:last-child {
  border-bottom: none;
}

.bill-hover {
  background: #fafbff;
}

.bill-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  margin-right: 20rpx;
}

.bill-main {
  flex: 1;
  min-width: 0;
}

.bill-cat {
  display: block;
  font-size: 28rpx;
}

.bill-note {
  display: block;
  font-size: 24rpx;
  color: #9aa0b5;
  margin-top: 4rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.bill-amount {
  font-size: 32rpx;
  font-weight: 600;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: #4b6ef5;
  color: #ffffff;
  font-size: 52rpx;
  line-height: 94rpx;
  text-align: center;
  box-shadow: 0 12rpx 28rpx rgba(75, 110, 245, 0.4);
}
