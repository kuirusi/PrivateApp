.budget-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  border-bottom: 2rpx solid #f0f2f8;
  padding-bottom: 16rpx;
}

.cny {
  font-size: 34rpx;
  color: #9aa0b5;
  margin-right: 12rpx;
}

.budget-input {
  flex: 1;
  font-size: 44rpx;
  font-weight: 600;
  height: 72rpx;
}

.save-btn {
  padding: 10rpx 32rpx;
  background: #4b6ef5;
  color: #ffffff;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.stat-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
}

.stat-item {
  width: 50%;
  text-align: center;
  margin-bottom: 24rpx;
}

.stat-value {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #9aa0b5;
  margin-top: 6rpx;
}

.date-row {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
  color: #9aa0b5;
  border-top: 2rpx solid #f2f4f9;
  padding-top: 20rpx;
}

.menu {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 2rpx solid #f2f4f9;
  font-size: 28rpx;
}

.menu:last-child {
  border-bottom: none;
}

.menu.danger {
  color: #ef5b6b;
}

.arrow {
  color: #c7ccdb;
  font-size: 34rpx;
}

.footer {
  padding: 24rpx 40rpx;
  font-size: 22rpx;
  color: #a8afc2;
  text-align: center;
  line-height: 1.6;
}
